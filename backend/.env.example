PORT=7201
MONGODB_URI=mongodb://127.0.0.1:27017/wazeer
JWT_SECRET=change-me-to-a-long-random-string

# Optional: where uploaded images and restore safety snapshots live (defaults: ./uploads, ./backups)
# UPLOAD_DIR=
# BACKUP_DIR=

# Who may call this API from a browser. Defaults to the production site, the API domain and
# localhost:4200. The app itself is same-origin, so this only matters for other websites.
# CORS_ORIGINS=https://fwr.limecodelabs.com,http://localhost:4200

# How many proxies sit in front of this app. Load-bearing: without it req.ip is the proxy's
# own address and the login throttle treats every caller as one. Default 1.
# TRUST_PROXY=1

# Login throttle. Only FAILED attempts count and a success clears the record.
# LOGIN_RATE_MAX_FAILURES=10
# LOGIN_RATE_WINDOW_MINUTES=15

# Remote storage for backups (Settings → Remote Storage, and the nightly cron job).
# S3 underneath; never named as such in the UI. Restart the backend after changing these.
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_PREFIX=wazeer-backup/   # "folder" inside the bucket (default shown)
# S3_ENDPOINT=               # only for S3-compatible stores (MinIO, R2, …); leave unset for AWS

# Nightly backup cron (scripts/run-cloud-backup.js, 23:50 Asia/Colombo).
# BACKUP_KEEP=15             # how many backups to keep in the bucket; by count, never by age
# BACKUP_MAX_AGE_HOURS=30    # watchdog staleness threshold (scripts/check-cloud-backup.js)

# SMS alerts when a backup fails (Notify.lk). Without these, failures only reach the cron log.
# SMS_ENABLE=true
# SMS_USER_ID=
# SMS_API_KEY=
# SMS_SENDER_ID=NotifyDEMO   # shared test sender; register your own for reliable delivery
# BACKUP_ALERT_SMS=          # comma-separated Sri Lankan mobiles, e.g. 0771234567
# BACKUP_ALERT_PREFIX=wazeer # tag at the start of each alert
