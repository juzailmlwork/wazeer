PORT=7201
MONGODB_URI=mongodb://127.0.0.1:27017/wazeer
JWT_SECRET=change-me-to-a-long-random-string

# Optional: where uploaded images and restore safety snapshots live (defaults: ./uploads, ./backups)
# UPLOAD_DIR=
# BACKUP_DIR=

# Optional: S3 backups (Settings → Amazon S3). Restart the backend after changing these.
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_PREFIX=wazeer-backups/
# S3_ENDPOINT=            # only for S3-compatible stores (MinIO, R2, …); leave unset for AWS
